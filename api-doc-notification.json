{
  "openapi": "3.0.3",
  "info": {
    "title": "Notification Service API",
    "description": "# Notification Service API Documentation\n\nA comprehensive notification service that supports multiple delivery channels (Email, SSE, Push) \nwith template management and user preferences.\n\n## Features\n- 📧 **Email Notifications** - Send templated emails via SMTP\n- 🔔 **Real-time SSE** - Server-Sent Events for instant notifications\n- 📱 **Push Notifications** - (Coming soon)\n- 🎨 **Template Management** - Dynamic templates with variable substitution\n- ⚙️ **User Preferences** - Customizable notification settings\n- 🔄 **Event-Driven** - Redis Streams for reliable event processing\n- 🔁 **Retry Mechanism** - Automatic retry for failed notifications\n\n## Authentication\nAll endpoints (except health check) require JWT Bearer token authentication from Casdoor OAuth2.\n\n## Base URL\n- **Development**: `http://localhost:8082/notification-service`\n- **Production**: `https://api.yourcompany.com/notification-service`\n",
    "contact": {
      "name": "Notification Service Team",
      "email": "support@examplatform.com"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8082/notification-service",
      "description": "Development server"
    },
    {
      "url": "https://api.yourcompany.com/notification-service",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Service health and status endpoints"
    },
    {
      "name": "Authentication",
      "description": "Authentication testing endpoints"
    },
    {
      "name": "Templates",
      "description": "Notification template management (Admin only)"
    },
    {
      "name": "Preferences",
      "description": "User notification preferences"
    },
    {
      "name": "SSE",
      "description": "Server-Sent Events for real-time notifications"
    },
    {
      "name": "Events",
      "description": "Event publishing for testing (Admin only)"
    },
    {
      "name": "Admin",
      "description": "Administrative operations (Admin only)"
    }
  ],
  "paths": {
    "/actuator/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check",
        "description": "Check if the service is running and healthy",
        "operationId": "healthCheck",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_200"
                },
                "example": {
                  "status": "UP",
                  "components": {
                    "db": {
                      "status": "UP"
                    },
                    "redis": {
                      "status": "UP"
                    }
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },

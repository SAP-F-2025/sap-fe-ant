    "/api/v1/sse/connect": {
      "get": {
        "tags": [
          "SSE"
        ],
        "summary": "Connect to SSE stream",
        "description": "Establish a Server-Sent Events connection to receive real-time notifications.\n\n**Note**: You can pass JWT token either as:\n- Authorization header: `Bearer YOUR_TOKEN`\n- Query parameter: `?token=YOUR_TOKEN` (for browser EventSource compatibility)\n\nKeep this connection open to receive events.\n",
        "operationId": "connectSSE",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "description": "JWT token (alternative to Authorization header)",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE connection established",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "examples": {
                  "connectionEvent": {
                    "value": "event: connect\ndata: {\"message\":\"Connected to notification service\",\"userId\":123,\"timestamp\":\"2025-11-23T10:00:00Z\"}\n"
                  },
                  "notificationEvent": {
                    "value": "event: notification\ndata: {\"type\":\"assessment.published\",\"content\":\"<html>...</html>\",\"timestamp\":\"2025-11-23T10:01:00Z\"}\n"
                  },
                  "heartbeatEvent": {
                    "value": "event: heartbeat\ndata: {\"timestamp\":\"2025-11-23T10:02:00Z\",\"type\":\"heartbeat\"}\n"
                  }
                }
              }
            }
          }
        }
      }
    },
